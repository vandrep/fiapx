{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "sources_consulted", "application_state", "logical_model_id", "component_ids", "topology_decision_id", "application_quanta", "keycloak_role", "durability_decision_status", "java_quarkus_status", "implementation_claimed", "historical_model_used_as_current", "meta_pdca", "next_step"],
  "properties": {
    "scenario_id": {"type": "string"},
    "sources_consulted": {"type": "array", "items": {"type": "string"}},
    "application_state": {"type": "string"},
    "logical_model_id": {"type": "string"},
    "component_ids": {"type": "array", "items": {"type": "string"}},
    "topology_decision_id": {"type": "string"},
    "application_quanta": {"type": "array", "items": {"type": "string"}},
    "keycloak_role": {"type": "string"},
    "durability_decision_status": {"type": "string"},
    "java_quarkus_status": {"type": "string"},
    "implementation_claimed": {"type": "boolean"},
    "historical_model_used_as_current": {"type": "boolean"},
    "meta_pdca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_found", "result"],
      "properties": {"failure_found": {"type": "boolean"}, "result": {"type": "string"}}
    },
    "next_step": {"type": "string"}
  }
}
