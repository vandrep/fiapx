{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "sources_consulted", "gates", "implemented_controls_claimed", "risk_reduced_claimed", "meta_pdca", "next_step"],
  "properties": {
    "scenario_id": {"type": "string"},
    "sources_consulted": {"type": "array", "items": {"type": "string"}},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threat_id", "control_state", "gate", "expected_evidence", "open_gap"],
        "properties": {
          "threat_id": {"type": "string"},
          "control_state": {"type": "string"},
          "gate": {"type": "string"},
          "expected_evidence": {"type": "string"},
          "open_gap": {"type": "string"}
        }
      }
    },
    "implemented_controls_claimed": {"type": "boolean"},
    "risk_reduced_claimed": {"type": "boolean"},
    "meta_pdca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_found", "result"],
      "properties": {"failure_found": {"type": "boolean"}, "result": {"type": "string"}}
    },
    "next_step": {"type": "string"}
  }
}
