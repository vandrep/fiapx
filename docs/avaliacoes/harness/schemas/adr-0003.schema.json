{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "sources_consulted", "decision_id", "decision_status", "recommendation", "risks", "accepted_technologies", "candidate_technologies", "verification_gaps", "java_quarkus_status", "meta_pdca", "next_step"],
  "properties": {
    "scenario_id": {"type": "string", "const": "EVAL-HARNESS-ADR-001"},
    "sources_consulted": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "decision_id": {"type": "string", "const": "DEC-0003"},
    "decision_status": {"type": "string", "const": "em_analise"},
    "recommendation": {"type": "string"},
    "risks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threat_id", "impact", "unresolved_evidence"],
        "properties": {
          "threat_id": {"type": "string", "enum": ["THR-013", "THR-014", "THR-015"]},
          "impact": {"type": "string"},
          "unresolved_evidence": {"type": "string"}
        }
      }
    },
    "accepted_technologies": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "candidate_technologies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_gaps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "java_quarkus_status": {"type": "string", "const": "preferencia"},
    "meta_pdca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_found", "result"],
      "properties": {
        "failure_found": {"type": "boolean"},
        "result": {"type": "string"}
      }
    },
    "next_step": {"type": "string"}
  }
}
