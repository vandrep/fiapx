        {"code": "GRAPH-004", "expression": "any(.sources_consulted[]; contains(\"docs/contexto/roteador.md\")) and any(.sources_consulted[]; contains(\"docs/contexto/README.md\")) and any(.sources_consulted[]; contains(\"docs/acompanhamento/roadmap.md\")) and any(.sources_consulted[]; contains(\"docs/acompanhamento/realizacoes.md\"))"},
