        {"code": "ADR-004", "expression": "(.verification_gaps | length) > 0 and (.candidate_technologies | length) > 0"},
        {"code": "ADR-005", "expression": "any(.sources_consulted[]; contains(\"docs/contexto/roteador.md\")) and any(.sources_consulted[]; contains(\"docs/arquitetura/decisoes/0003-entrega-duravel-e-persistencia.md\")) and any(.sources_consulted[]; contains(\"docs/arquitetura/modelo-ameacas.md\"))"}
